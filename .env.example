# ---------- ASI:One LLM (https://asi1.ai -> Developer -> API Keys) ----------
ASI1_API_KEY=
# asi1 (default) | asi1-mini (fast) | asi1-ultra (deep reasoning)
ASI1_MODEL=asi1
# Let the LLM search the web to discover businesses / official websites (candidates are always verified by crawling)
ASI1_WEB_SEARCH=true
# How much search context ASI:One pulls in: low | medium | high
ASI1_SEARCH_CONTEXT=medium

# ---------- Agent seeds: they fix each agent's address. Long random strings, NEVER commit. ----------
#   python -c "import secrets; print(secrets.token_hex(32))"   (setup.sh generates these)
ORCH_SEED=
FINDER_SEED=
CONTACT_SEED=
ANALYST_SEED=
WRITER_SEED=
SENDER_SEED=

# ---------- Specialist addresses (derived from the seeds; setup.sh fills these) ----------
LEAD_FINDER_AGENT_ADDRESS=
CONTACT_FINDER_AGENT_ADDRESS=
LEAD_ANALYST_AGENT_ADDRESS=
COPYWRITER_AGENT_ADDRESS=
SENDER_AGENT_ADDRESS=

# ---------- Optional extra lead sources (unused unless set) ----------
FOURSQUARE_API_KEY=
GOOGLE_PLACES_API_KEY=

# ---------- Runtime ----------
# true = reachable through the Agentverse mailbox (needed for ASI:One). Tests force false.
MAILBOX=true
# true = store all campaign state under one key (use if the ASI:One sender address is not stable)
OWNER_MODE=false
ORCH_PORT=8001
FINDER_PORT=8002
CONTACT_PORT=8003
ANALYST_PORT=8004
WRITER_PORT=8005
SENDER_PORT=8006

# ---------- Hosted demo cap (IST day). Self-hosters use their own ASI1 key. ----------
# New campaigns per sender, and for the whole demo. A new IST day resets both.
MAX_CAMPAIGNS_PER_USER_PER_DAY=3
MAX_CAMPAIGNS_PER_DAY=20

# ---------- Sending (stretch). Safe defaults: nothing reaches a real business. ----------
RESEND_API_KEY=
SENDER_FROM=
# Also used in the crawler User-Agent so site owners can contact us
REPLY_TO=
DRY_RUN=true
TEST_REDIRECT_TO=
DAILY_CAP=5
